# LangChain Configuration
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=deep-search-terminal-agent
LANGCHAIN_API_KEY=your_langchain_api_key_here

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/openai/deployments/your-deployment-name/chat/completions?api-version=2023-03-15-preview/
AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name
AZURE_OPENAI_API_VERSION=2023-03-15-preview

# Tavily API (Optional - for additional search capabilities)
TAVILY_API_KEY=your_tavily_api_key_here

# Model Configuration
MODEL_NAME=gpt-4o
TEMPERATURE=0.1
MAX_TOKENS=4000

# Agent Configuration
DEBUG_MODE=False
MAX_ATTEMPTS=3 